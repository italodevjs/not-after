{
  "name": "not-after",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local workbench for public X.509 certificates and their validity windows.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "inspect": "tsx src/cli.ts",
    "fixtures": "tsx scripts/fixtures.ts"
  },
  "dependencies": {
    "@peculiar/x509": "3.1.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "^4.0.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
